# Production template — copy to /var/www/spotter-eld/api/.env on the VPS.
# Never commit real secrets. Never reuse Vehicle Daily Check credentials/DB.

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=assessment.vehicledailycheck.com
CORS_ALLOWED_ORIGINS=https://assessment.vehicledailycheck.com
CSRF_TRUSTED_ORIGINS=https://assessment.vehicledailycheck.com
USE_X_FORWARDED_HOST=true

# Isolated DB (create: CREATE DATABASE spotter_eld OWNER spotter_eld;)
POSTGRES_DB=spotter_eld
POSTGRES_USER=spotter_eld
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

MAP_USER_AGENT=SpotterELDTripPlanner/1.0 (assessment; https://assessment.vehicledailycheck.com)
MAP_HTTP_TIMEOUT=25
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
