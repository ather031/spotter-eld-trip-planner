# Copy to /var/www/spotter-eld/api/.env — never commit real secrets.
# Never reuse Vehicle Daily Check DB or .env.

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=assessment.vehicledailycheck.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://assessment.vehicledailycheck.com
# Same-origin frontend (nginx serves web + /api) — CORS optional but safe:
CORS_ALLOWED_ORIGINS=https://assessment.vehicledailycheck.com
USE_X_FORWARDED_HOST=true

# Prefer one DATABASE_URL, OR the discrete POSTGRES_* vars (not both conflicting).
# After: sudo -u postgres psql -c "CREATE DATABASE spotter_eld;"
# Option A — dedicated role (recommended):
#   CREATE USER spotter_eld WITH PASSWORD 'STRONG_PASSWORD';
#   GRANT ALL PRIVILEGES ON DATABASE spotter_eld TO spotter_eld;
#   (PG15+) connect to spotter_eld and: GRANT ALL ON SCHEMA public TO spotter_eld;
DATABASE_URL=postgres://spotter_eld:STRONG_PASSWORD@127.0.0.1:5432/spotter_eld

# Option B — discrete vars (if you skip DATABASE_URL):
# POSTGRES_DB=spotter_eld
# POSTGRES_USER=spotter_eld
# POSTGRES_PASSWORD=STRONG_PASSWORD
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

MAP_USER_AGENT=SpotterELDTripPlanner/1.0 (assessment; https://assessment.vehicledailycheck.com)
MAP_HTTP_TIMEOUT=25
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
