[Unit]
Description=Spotter ELD Trip Planner API (assessment)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/spotter-eld/api
EnvironmentFile=/var/www/spotter-eld/api/.env
ExecStart=/var/www/spotter-eld/api/.venv/bin/gunicorn \
    --bind 127.0.0.1:8001 \
    --workers 2 \
    --threads 2 \
    --timeout 120 \
    --access-logfile /var/log/spotter-eld/gunicorn-access.log \
    --error-logfile /var/log/spotter-eld/gunicorn-error.log \
    config.wsgi:application
Restart=on-failure
RestartSec=3
PrivateTmp=true

[Install]
WantedBy=multi-user.target
