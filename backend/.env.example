DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# PostgreSQL — create this DB locally first (see README)
POSTGRES_DB=spotter_eld
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Or one-liner instead of the vars above:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/spotter_eld

# Free map APIs (override only if self-hosting)
MAP_USER_AGENT=SpotterELDTripPlanner/1.0 (assessment; local-dev)
MAP_HTTP_TIMEOUT=20
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org

# Production subdomain example (assessment.vehicledailycheck.com):
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=assessment.vehicledailycheck.com
# CORS_ALLOWED_ORIGINS=https://assessment.vehicledailycheck.com
# CSRF_TRUSTED_ORIGINS=https://assessment.vehicledailycheck.com
# USE_X_FORWARDED_HOST=true
# MAP_USER_AGENT=SpotterELDTripPlanner/1.0 (assessment; https://assessment.vehicledailycheck.com)
